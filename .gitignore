# creative-context is a vendored prebuilt package (copied by the slides
# scaffolder); Vercel's pnpm install skips its prepare/postinstall build,
# so its dist must be committed for production builds to resolve it.
!packages/creative-context/dist/
.deploy-tmp/

# Env files — never commit secrets
.env
.env.local
apps/*/.env
apps/*/.env.local
packages/*/.env

